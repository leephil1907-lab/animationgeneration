# Local ComfyUI API endpoint
COMFYUI_URL=http://127.0.0.1:8188

# Default checkpoints, read by lib/comfy/workflow.ts normalizeSettings().
# Must match filenames actually installed in ComfyUI. Leave blank to pick per
# sequence in the storyboard UI, or to rely on an imported API-format workflow.
COMFYUI_CHECKPOINT=
COMFYUI_VIDEO_CHECKPOINT=

# ComfyUI client tuning (lib/comfy/client.ts)
COMFYUI_TIMEOUT_MS=20000
COMFYUI_RETRIES=1

# Polls before an unfinished job is marked failed instead of spinning forever
MOTIONA_MAX_POLLS=240

# Server-side authentication (Supabase Auth)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
MOTIONA_AUTH_REQUIRED=true

# OpenAI services (server-side only)
OPENAI_DIRECTOR_MODEL=gpt-5

# OpenAI speech-to-text (server-side only)
OPENAI_API_KEY=

# Optional ElevenLabs text-to-speech (server-side only)
ELEVENLABS_API_KEY=
ELEVENLABS_WARM_FEMALE_VOICE_ID=
ELEVENLABS_DEEP_MALE_VOICE_ID=
ELEVENLABS_SOFT_BREATHY_VOICE_ID=
ELEVENLABS_ENERGETIC_VOICE_ID=
ELEVENLABS_CALM_NARRATOR_VOICE_ID=

# Optional agent integrations
SEARCH_API_KEY=
X_BEARER_TOKEN=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional persistent storage adapter (future)
STORAGE_PROVIDER=local-file
STORAGE_BUCKET=
STORAGE_PUBLIC_BASE_URL=
